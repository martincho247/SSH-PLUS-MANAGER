#!/bin/bash
# Menu SSH-PLUS-MANAGER con HWID

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

show_menu() {
    clear
    echo -e "${CYAN}=======================================${NC}"
    echo -e "${CYAN}  SSH-PLUS-MANAGER                    ${NC}"
    echo -e "${CYAN}=======================================${NC}"
    echo ""
    echo -e "${WHITE}[01] • CREATE USER              [11] • SPEEDTEST${NC}"
    echo -e "${WHITE}[02] • CREATE HWID              [12] • BANNER${NC}"
    echo -e "${WHITE}[03] • REMOVE USER              [13] • TRAFFIC${NC}"
    echo -e "${WHITE}[04] • MONITOR ONLINE           [14] • OPTIMIZE${NC}"
    echo -e "${WHITE}[05] • CHANGE DATE              [15] • BACKUP${NC}"
    echo -e "${WHITE}[06] • CHANGE LIMIT             [16] • LIMITER ○${NC}"
    echo -e "${WHITE}[07] • CHANGE PASSWORD          [17] • BAD VPN ○${NC}"
    echo -e "${WHITE}[08] • REMOVE EXPIRED           [18] • INFO VPS${NC}"
    echo -e "${WHITE}[09] • USER REPORT              [19] • MORE >>>${NC}"
    echo -e "${WHITE}[10] • CONNECTION MODE          [00] • GET OUT <<<${NC}"
    echo ""
    echo -e "${CYAN}Comandos HWID:${NC}"
    echo -e "${YELLOW}  criarhwid  - Crear licencia HWID${NC}"
    echo -e "${YELLOW}  verhwid    - Ver HWIDs registrados${NC}"
    echo -e "${YELLOW}  delhwid    - Eliminar HWID${NC}"
    echo ""
    read -p "Selecciona una opción: " option
    
    case $option in
        1) bash /bin/criarusuario ;;
        2) bash /bin/criarhwid ;;
        3) bash /bin/remover ;;
        4) bash /bin/monitor ;;
        5) bash /bin/mudardata ;;
        6) bash /bin/limitar ;;
        7) bash /bin/mudarsenha ;;
        8) bash /bin/expcleaner ;;
        9) bash /bin/menuv1 ;;
        10) bash /bin/menuv2 ;;
        11) bash /bin/speedtest ;;
        12) bash /bin/banner ;;
        13) bash /bin/trafego ;;
        14) bash /bin/otimizar ;;
        15) bash /bin/backup ;;
        16) bash /bin/limiter ;;
        17) bash /bin/badvpn ;;
        18) bash /bin/info ;;
        19) bash /bin/menuv3 ;;
        00) exit 0 ;;
        *) echo -e "${RED}Opción inválida${NC}"; sleep 2; show_menu ;;
    esac
}

show_menu