#!/bin/bash

get_system_info() {
    IP=$(cat /etc/IP 2>/dev/null || echo "DESCONOCIDO")
    SISTEMA=$(cat /etc/os-release | grep "PRETTY_NAME" | cut -d'"' -f2)
    HORA=$(date +%H:%M:%S)
    RAM_TOTAL=$(free -h | awk '/Mem:/ {print $2}')
    RAM_PORCENTAJE=$(free | awk '/Mem:/ {printf "%.2f", $3/$2 * 100}')
    NUCLEOS=$(nproc)
    CPU_USO=$(top -bn1 | grep "Cpu(s)" | awk '{print $2}' | cut -d'%' -f1)
    ONLINE=$(ps aux | grep -c "sshd:" 2>/dev/null)
    ONLINE=$((ONLINE - 1))
    if [ $ONLINE -lt 0 ]; then ONLINE=0; fi
    EXPIRADOS=0
    TOTAL=0
    if [ -f /root/usuarios.db ]; then
        TOTAL=$(wc -l < /root/usuarios.db)
    fi
}

show_menu() {
    clear
    get_system_info
    
    echo -e "\033[1;31m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "\033[1;33mSISTEMA            RAM MEMORY        PROCESSOR\033[0m"
    echo -e "\033[1;37mOS: \033[1;36m$SISTEMA\033[0m     \033[1;37mTotal: \033[1;36m$RAM_TOTAL\033[0m     \033[1;37mNuclei: \033[1;36m$NUCLEOS\033[0m"
    echo -e "\033[1;37mHour: \033[1;36m$HORA\033[0m     \033[1;37mIn use: \033[1;36m$RAM_PORCENTAJE%\033[0m   \033[1;37mIn use: \033[1;36m$CPU_USO%\033[0m"
    echo -e "\033[1;31m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "\033[1;37mOnline: \033[1;32m$ONLINE\033[0m         \033[1;37mExpired: \033[1;31m$EXPIRADOS\033[0m     \033[1;37mTotal: \033[1;36m$TOTAL\033[0m"
    echo -e "\033[1;31m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo ""
    
    echo -e "\033[1;37m[01] • CREAR USUARIO            [11] • TEST DE VELOCIDAD\033[0m"
    echo -e "\033[1;37m[02] • SISTEMA HWID             [12] • BANNER\033[0m"
    echo -e "\033[1;37m[03] • ELIMINAR USUARIO         [13] • DETALLES\033[0m"
    echo -e "\033[1;37m[04] • MONITOR ONLINE           [14] • OPTIMIZAR\033[0m"
    echo -e "\033[1;37m[05] • CAMBIAR FECHA            [15] • BACKUP\033[0m"
    echo -e "\033[1;37m[06] • CAMBIAR LÍMITE           [16] • LIMITADOR ○\033[0m"
    echo -e "\033[1;37m[07] • CAMBIAR CONTRASEÑA       [17] • BAD VPN ○\033[0m"
    echo -e "\033[1;37m[08] • ELIMINAR EXPIRADOS       [18] • INFO VPS\033[0m"
    echo -e "\033[1;37m[09] • REPORTE DE USUARIOS      [19] • MÁS >>>\033[0m"
    echo -e "\033[1;37m[10] • MODO DE CONEXIÓN         [00] • SALIR <<<\033[0m"
    echo ""
    read -p "Selecciona una opción: " option

    case $option in
        1) /bin/criarusuario; show_menu ;;
        2) menu_hwid ;;
        3) /bin/remover; show_menu ;;
        4) /bin/sshmonitor; show_menu ;;
        5) /bin/mudardata; show_menu ;;
        6) /bin/alterarlimite; show_menu ;;
        7) /bin/alterarsenha; show_menu ;;
        8) /bin/uexpired; show_menu ;;
        9) /bin/infousers; show_menu ;;
        10) /bin/conexao; show_menu ;;
        11) /bin/speedtest; show_menu ;;
        12) /bin/banner; show_menu ;;
        13) /bin/detalhes; show_menu ;;
        14) /bin/otimizar; show_menu ;;
        15) /bin/userbackup; show_menu ;;
        16) /bin/limiter; show_menu ;;
        17) /bin/badvpn; show_menu ;;
