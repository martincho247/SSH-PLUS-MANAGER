cat > /bin/menu << 'EOF'
#!/bin/bash

show_menu() {
    clear
    echo "======================================="
    echo "  SSH-PLUS-MANAGER                    "
    echo "======================================="
    echo ""
    echo "[01] CREATE USER              [11] SPEEDTEST"
    echo "[02] SISTEMA HWID             [12] BANNER"
    echo "[03] REMOVE USER              [13] TRAFFIC"
    echo "[04] MONITOR ONLINE           [14] OPTIMIZE"
    echo "[05] CHANGE DATE              [15] BACKUP"
    echo "[06] CHANGE LIMIT             [16] LIMITER"
    echo "[07] CHANGE PASSWORD          [17] BAD VPN"
    echo "[08] REMOVE EXPIRED           [18] INFO VPS"
    echo "[09] USER REPORT              [19] MORE"
    echo "[10] CONNECTION MODE          [00] EXIT"
    echo ""
    read -p "Selecciona una opción: " option

    case $option in
        1) /bin/criarusuario ;;
        2) menu_hwid ;;
        3) /bin/remover ;;
        4) /bin/monitor ;;
        5) /bin/mudardata ;;
        6) /bin/limitar ;;
        7) /bin/mudarsenha ;;
        8) /bin/expcleaner ;;
        9) /bin/menuv1 ;;
        10) /bin/menuv2 ;;
        11) /bin/speedtest ;;
        12) /bin/banner ;;
        13) /bin/trafego ;;
        14) /bin/otimizar ;;
        15) /bin/backup ;;
        16) /bin/limiter ;;
        17) /bin/badvpn ;;
        18) /bin/info ;;
        19) /bin/menuv3 ;;
        00) exit 0 ;;
        *) echo "Opción inválida"; sleep 2; show_menu ;;
    esac
}

menu_hwid() {
    clear
    echo "======================================="
    echo "  SISTEMA HWID                        "
    echo "======================================="
    echo ""
    echo "[1] CREAR HWID"
    echo "[2] VER HWIDs REGISTRADOS"
    echo "[3] ELIMINAR HWID"
    echo "[0] VOLVER AL MENÚ PRINCIPAL"
    echo ""
    read -p "Selecciona una opción: " hwid_option

    case $hwid_option in
        1) /bin/criarhwid; menu_hwid ;;
        2) /bin/verhwid; menu_hwid ;;
        3) /bin/delhwid; menu_hwid ;;
        0) show_menu ;;
        *) echo "Opción inválida"; sleep 2; menu_hwid ;;
    esac
}

show_menu
EOF

chmod +x /bin/menu

# Probar
menu