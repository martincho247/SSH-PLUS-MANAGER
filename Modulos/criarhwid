#!/bin/bash
#===================================================
# Módulo: Criar HWID
# SSH-PLUS-MANAGER
#===================================================

# Colores
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

# Función para imprimir mensajes
print_message() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_header() {
    clear
    echo -e "${CYAN}=======================================${NC}"
    echo -e "${CYAN}  CRIAR HWID - SISTEMA DE LICENÇAS    ${NC}"
    echo -e "${CYAN}=======================================${NC}"
    echo ""
}

# Función para obter HWID do sistema
get_system_hwid() {
    # Tentar diferentes métodos para obter HWID
    if [ -f /etc/machine-id ]; then
        HWID=$(cat /etc/machine-id)
    elif [ -f /var/lib/dbus/machine-id ]; then
        HWID=$(cat /var/lib/dbus/machine-id)
    elif command -v dmidecode &> /dev/null; then
        HWID=$(dmidecode -s system-uuid)
    elif command -v ifconfig &> /dev/null; then
        HWID=$(ifconfig | grep -o -E '([[:xdigit:]]{1,2}:){5}[[:xdigit:]]{1,2}' | head -n 1 | md5sum | cut -d' ' -f1)
    else
        HWID=$(cat /proc/sys/kernel/random/uuid)
    fi
    
    echo "$HWID"
}

# Função para gerar licença
generate_license() {
    local hwid=$1
    local secret_key="ssh-plus-manager-secret"
    
    # Gerar licença usando SHA256
    LICENSE=$(echo "$hwwid" | openssl dgst -sha256 -hmac "$secret_key" | awk '{print $2}')
    
    echo "$LICENSE"
}

# Função principal para criar HWID
criar_hwid() {
    print_header
    
    # Obter HWID do sistema
    SYSTEM_HWID=$(get_system_hwid)
    
    echo -e "${WHITE}HWID do Sistema: ${YELLOW}$SYSTEM_HWID${NC}"
    echo ""
    
    # Menu de opções
    echo -e "${CYAN}Opções:${NC}"
    echo "1. Registrar este HWID"
    echo "2. Gerar Licença para este HWID"
    echo "3. Gerar Licença para outro HWID"
    echo "4. Listar HWIDs registrados"
    echo "5. Remover HWID"
    echo "6. Voltar ao menu principal"
    echo ""
    read -p "Selecione uma opção [1-6]: " option
    
    case $option in
        1)
            # Registrar HWID
            HWID_DIR="/etc/ssh-plus/hwid"
            mkdir -p $HWID_DIR
            
            echo "$SYSTEM_HWID" > $HWID_DIR/hwid.txt
            echo "$SYSTEM_HWID:$(date +%Y-%m-%d_%H:%M:%S)" >> $HWID_DIR/registered_hwids.txt
            
            print_message "HWID registrado com sucesso!"
            echo -e "${CYAN}HWID: ${YELLOW}$SYSTEM_HWID${NC}"
            ;;
            
        2)
            # Gerar licença para este HWID
            LICENSE=$(generate_license "$SYSTEM_HWID")
            
            echo -e "${GREEN}✓ Licença gerada com sucesso!${NC}"
            echo ""
            echo -e "${CYAN}HWID: ${YELLOW}$SYSTEM_HWID${NC}"
            echo -e "${CYAN}Licença: ${YELLOW}$LICENSE${NC}"
            echo ""
            
            # Salvar licença
            HWID_DIR="/etc/ssh-plus/hwid"
            mkdir -p $HWID_DIR/licenses
            echo "$SYSTEM_HWID:$LICENSE:$(date +%Y-%m-%d)" > $HWID_DIR/licenses/current_license.txt
            
            print_message "Licença salva em: $HWID_DIR/licenses/current_license.txt"
            ;;
            
        3)
            # Gerar licença para outro HWID
            read -p "Digite o HWID do cliente: " client_hwid
            
            if [ -z "$client_hwid" ]; then
                print_error "HWID vazio!"
                return 1
            fi
            
            LICENSE=$(generate_license "$client_hwid")
            
            echo -e "${GREEN}✓ Licença gerada com sucesso!${NC}"
            echo ""
            echo -e "${CYAN}HWID: ${YELLOW}$client_hwid${NC}"
            echo -e "${CYAN}Licença: ${YELLOW}$LICENSE${NC}"
            echo ""
            
            # Salvar licença
            HWID_DIR="/etc/ssh-plus/hwid"
            mkdir -p $HWID_DIR/licenses
            echo "$client_hwid:$LICENSE:$(date +%Y-%m-%d)" >> $HWID_DIR/licenses/all_licenses.txt
            
            print_message "Licença adicionada ao banco de dados"
            ;;
            
        4)
            # Listar HWIDs registrados
            HWID_DIR="/etc/ssh-plus/hwid"
            
            echo -e "${CYAN}HWIDs Registrados:${NC}"
            echo -e "${WHITE}========================================${NC}"
            
            if [ -f "$HWID_DIR/registered_hwids.txt" ]; then
                cat $HWID_DIR/registered_hwids.txt
            else
                print_warning "Nenhum HWID registrado"
            fi
            
            echo -e "${WHITE}========================================${NC}"
            ;;
            
        5)
            # Remover HWID
            HWID_DIR="/etc/ssh-plus/hwid"
            
            read -p "Digite o HWID a ser removido: " hwid_remove
            
            if [ -f "$HWID_DIR/registered_hwids.txt" ]; then
                # Backup antes de remover
                cp $HWID_DIR/registered_hwids.txt $HWID_DIR/registered_hwids_backup.txt
                
                # Remover HWID
                sed -i "/^$hwid_remove:/d" $HWID_DIR/registered_hwids.txt
                
                print_message "HWID removido com sucesso!"
            else
                print_warning "Arquivo de HWIDs não encontrado"
            fi
            ;;
            
        6)
            # Voltar ao menu principal
            return 0
            ;;
            
        *)
            print_error "Opção inválida!"
            ;;
    esac
    
    echo ""
    read -p "Pressione ENTER para continuar..."
}

# Executar módulo
criar_hwid