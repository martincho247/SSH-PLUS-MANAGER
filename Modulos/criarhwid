#!/bin/bash
#===================================================
# Instalador del Sistema HWID - SSH-PLUS-MANAGER
#===================================================

# Colores
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Función para imprimir mensajes
print_message() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_header() {
    clear
    echo -e "${CYAN}=======================================${NC}"
    echo -e "${CYAN}  SISTEMA HWID - INSTALADOR           ${NC}"
    echo -e "${CYAN}=======================================${NC}"
    echo ""
}

# Verificar root
check_root() {
    if [[ $EUID -ne 0 ]]; then
        print_error "Este script debe ejecutarse como root"
        print_warning "Usa: sudo $0"
        exit 1
    fi
}

# Obtener HWID del sistema
get_hwid() {
    print_message "Obteniendo HWID del sistema..."
    
    # Método 1: Usar machine-id
    if [ -f /etc/machine-id ]; then
        HWID=$(cat /etc/machine-id)
    # Método 2: Usar MAC address
    elif command -v ifconfig &> /dev/null; then
        HWID=$(ifconfig | grep -o -E '([[:xdigit:]]{1,2}:){5}[[:xdigit:]]{1,2}' | head -n 1 | md5sum | cut -d' ' -f1)
    # Método 3: Usar dmidecode
    elif command -v dmidecode &> /dev/null; then
        HWID=$(dmidecode -s system-uuid)
    else
        HWID=$(cat /proc/sys/kernel/random/uuid)
    fi
    
    echo -e "${CYAN}Tu HWID es: ${YELLOW}$HWID${NC}"
    echo ""
}

# Instalar dependencias necesarias
install_dependencies() {
    print_message "Instalando dependencias..."
    
    # Detectar SO
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        OS=$ID
    else
        OS=$(uname -s)
    fi
    
    case $OS in
        ubuntu|debian)
            apt update -y
            apt install -y curl wget python3 python3-pip openssl jq
            ;;
        centos|rhel|fedora)
            yum update -y
            yum install -y curl wget python3 python3-pip openssl jq
            ;;
        *)
            print_warning "SO no reconocido: $OS"
            ;;
    esac
    
    print_message "Dependencias instaladas"
}

# Instalar sistema HWID
install_hwid_system() {
    print_message "Instalando sistema HWID..."
    
    # Crear directorios
    HWID_DIR="/etc/ssh-plus/hwid"
    mkdir -p $HWID_DIR
    mkdir -p $HWID_DIR/keys
    mkdir -p $HWID_DIR/licenses
    
    # Descargar archivos del repositorio
    print_message "Descargando archivos del repositorio..."
    
    # Intentar descargar archivos HWID específicos
    wget -q https://raw.githubusercontent.com/martincho247/SSH-PLUS-MANAGER/master/hwid/check_hwid.sh -O $HWID_DIR/check_hwid.sh
    wget -q https://raw.githubusercontent.com/martincho247/SSH-PLUS-MANAGER/master/hwid/generate_key.sh -O $HWID_DIR/generate_key.sh
    wget -q https://raw.githubusercontent.com/martincho247/SSH-PLUS-MANAGER/master/hwid/validate_key.sh -O $HWID_DIR/validate_key.sh
    
    # Si los archivos específicos no existen, crear sistema básico
    if [ ! -s $HWID_DIR/check_hwid.sh ]; then
        print_warning "Creando sistema HWID básico..."
        
        # Crear script de verificación HWID
        cat > $HWID_DIR/check_hwid.sh << 'EOF'
#!/bin/bash
# Script de verificación HWID

HWID_FILE="/etc/ssh-plus/hwid/hwid.txt"
LICENSE_FILE="/etc/ssh-plus/hwid/licenses/license.txt"

# Obtener HWID actual
CURRENT_HWID=$(cat /etc/machine-id)

# Verificar si existe HWID registrado
if [ -f "$HWID_FILE" ]; then
    STORED_HWID=$(cat $HWID_FILE)
    if [ "$CURRENT_HWID" == "$STORED_HWID" ]; then
        echo "✓ HWID Válido"
        exit 0
    else
        echo "✗ HWID No coincide"
        exit 1
    fi
else
    echo "⚠ No hay HWID registrado"
    exit 2
fi
EOF
        
        # Crear script de generación de licencia
        cat > $HWID_DIR/generate_key.sh << 'EOF'
#!/bin/bash
# Generador de licencias

HWID=$1
if [ -z "$HWID" ]; then
    echo "Uso: $0 <HWID>"
    echo "Ejemplo: $0 1234567890abcdef"
    exit 1
fi

# Generar licencia basada en HWID
LICENSE=$(echo "$HWID" | openssl dgst -sha256 -hmac "ssh-plus-secret-key" | awk '{print $2}')
echo "Licencia generada: $LICENSE"
echo "HWID: $HWID"
echo "Licencia: $LICENSE" > /etc/ssh-plus/hwid/licenses/license.txt
EOF
        
        # Crear script de validación
        cat > $HWID_DIR/validate_key.sh << 'EOF'
#!/bin/bash
# Validador de licencias

LICENSE=$1
HWID_FILE="/etc/ssh-plus/hwid/hwid.txt"

if [ -z "$LICENSE" ]; then
    echo "Uso: $0 <licencia>"
    exit 1
fi

CURRENT_HWID=$(cat /etc/machine-id)
EXPECTED_LICENSE=$(echo "$CURRENT_HWID" | openssl dgst -sha256 -hmac "ssh-plus-secret-key" | awk '{print $2}')

if [ "$LICENSE" == "$EXPECTED_LICENSE" ]; then
    echo "✓ Licencia válida"
    echo "$LICENSE" > /etc/ssh-plus/hwid/licenses/license.txt
    exit 0
else
    echo "✗ Licencia inválida"
    exit 1
fi
EOF
    fi
    
    # Dar permisos de ejecución
    chmod +x $HWID_DIR/*.sh
    
    # Guardar HWID actual
    cat /etc/machine-id > $HWID_DIR/hwid.txt
    
    print_message "Sistema HWID instalado en: $HWID_DIR"
}

# Crear menú de opciones
show_menu() {
    print_header
    echo "1. Ver HWID del sistema"
    echo "2. Generar licencia para HWID"
    echo "3. Validar licencia"
    echo "4. Instalar/Actualizar sistema HWID"
    echo "5. Salir"
    echo ""
    read -p "Selecciona una opción [1-5]: " option
    
    case $option in
        1)
            get_hwid
            read -p "Presiona ENTER para continuar..."
            show_menu
            ;;
        2)
            get_hwid
            read -p "Ingresa el HWID para generar licencia: " hwid_input
            if [ -z "$hwid_input" ]; then
                hwid_input=$(cat /etc/machine-id)
            fi
            bash /etc/ssh-plus/hwid/generate_key.sh $hwid_input
            read -p "Presiona ENTER para continuar..."
            show_menu
            ;;
        3)
            read -p "Ingresa la licencia a validar: " license
            if [ ! -z "$license" ]; then
                bash /etc/ssh-plus/hwid/validate_key.sh $license
            fi
            read -p "Presiona ENTER para continuar..."
            show_menu
            ;;
        4)
            install_hwid_system
            read -p "Presiona ENTER para continuar..."
            show_menu
            ;;
        5)
            echo "Saliendo..."
            exit 0
            ;;
        *)
            print_error "Opción inválida"
            sleep 2
            show_menu
            ;;
    esac
}

# Función principal
main() {
    check_root
    print_header
    
    # Verificar si ya está instalado
    if [ -d "/etc/ssh-plus/hwid" ]; then
        print_message "Sistema HWID ya instalado"
        get_hwid
    else
        print_message "Instalando sistema HWID por primera vez..."
        install_dependencies
        install_hwid_system
        get_hwid
    fi
    
    echo ""
    read -p "¿Deseas abrir el menú de opciones? (s/n): " open_menu
    if [[ "$open_menu" == "s" || "$open_menu" == "S" ]]; then
        show_menu
    fi
    
    print_message "Instalación completada exitosamente"
    echo ""
    echo -e "${CYAN}Comandos disponibles:${NC}"
    echo "  /etc/ssh-plus/hwid/check_hwid.sh - Verificar HWID"
    echo "  /etc/ssh-plus/hwid/generate_key.sh <HWID> - Generar licencia"
    echo "  /etc/ssh-plus/hwid/validate_key.sh <licencia> - Validar licencia"
    echo ""
}

# Ejecutar script
main