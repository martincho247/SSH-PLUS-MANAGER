#!/bin/bash
IP=$(cat /etc/IP)
if [ ! -d /etc/SSHPlus/hwid ]; then
mkdir /etc/SSHPlus/hwid
fi
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%30s%s%-15s\n' "Create HWID" ; tput sgr0
echo ""
[ "$(ls -A /etc/SSHPlus/hwid 2>/dev/null)" ] && echo -e "\033[1;32mActive HWIDs!\033[1;37m" || echo -e "\033[1;31mNo active HWIDs!\033[0m"
echo ""
for hwidson in $(ls /etc/SSHPlus/hwid 2>/dev/null |sort |sed 's/.sh//g')
do
echo "$hwidson"
done
echo ""

# PEDIR NOMBRE
echo -ne "\033[1;32mNOMBRE\033[1;37m: "; read nome
if [[ -z $nome ]]
then
    echo ""
    tput setaf 7 ; tput setab 1 ; tput bold ; echo "" ; echo "Nombre vacío o inválido." ; echo "" ; tput sgr0
    exit 1
fi

# Verificar si el cliente ya existe
if [ -f /etc/SSHPlus/hwid/$nome.key ]; then
    tput setaf 7 ; tput setab 1 ; tput bold ; echo "" ; echo "Este cliente ya tiene un HWID registrado." ; echo "" ; tput sgr0
    exit 1
fi

# PEDIR HWID
echo -ne "\033[1;32mHWID\033[1;37m: "; read hwid_cliente
if [[ -z $hwid_cliente ]]
then
    echo ""
    tput setaf 7 ; tput setab 1 ; tput bold ; echo "" ; echo "HWID vacío o inválido." ; echo "" ; tput sgr0
    exit 1
fi

# PEDIR LIMITE
echo -ne "\033[1;32mLIMITE\033[1;37m: "; read limite
if [[ -z $limite ]]
then
    echo ""
    tput setaf 7 ; tput setab 1 ; tput bold ; echo "" ; echo "Límite vacío o inválido." ; echo "" ; tput sgr0
    exit 1
fi

# PEDIR DIAS
echo -ne "\033[1;32mDIAS \033[1;33m(\033[1;31mEx: \033[1;37m30\033[1;33m)\033[1;37m: "; read dias
if [[ -z $dias ]]
then
    echo ""
    tput setaf 7 ; tput setab 1 ; tput bold ; echo "" ; echo "Días vacíos o inválidos." ; echo "" ; tput sgr0
    exit 1
fi

# Generar licencia única
LICENSE=$(echo "$hwid_cliente$nome$(date +%s)" | md5sum | awk '{print $1}')
KEY="${LICENSE:0:8}-${LICENSE:8:4}-${LICENSE:12:4}-${LICENSE:16:4}-${LICENSE:20:12}"

# Crear directorios necesarios
mkdir -p /etc/SSHPlus/hwid

# Guardar información
echo "$nome|$hwid_cliente|$limite|$dias|$KEY|$(date +%Y-%m-%d)" >> /etc/SSHPlus/hwid/hwid.db
echo "$KEY" > /etc/SSHPlus/hwid/$nome.key

# Crear script de expiración
cat > /etc/SSHPlus/hwid/$nome.sh << EOF2
#!/bin/bash
# Script de expiración para $nome
if [ -f /etc/SSHPlus/hwid/$nome.key ]; then
    rm -f /etc/SSHPlus/hwid/$nome.key
    rm -f /etc/SSHPlus/hwid/$nome.sh
    grep -v "^$nome|" /etc/SSHPlus/hwid/hwid.db > /tmp/ph ; cat /tmp/ph > /etc/SSHPlus/hwid/hwid.db
fi
exit
EOF2

chmod +x /etc/SSHPlus/hwid/$nome.sh

# Programar expiración
at -f /etc/SSHPlus/hwid/$nome.sh now + $dias days > /dev/null 2>&1

clear
echo -e "\E[44;1;37m     HWID Creado Exitósamente     \E[0m"
echo ""
echo -e "\033[1;32m♻️ Sistema de Licencias HWID ♻️"
echo ""
echo -e "\033[1;32m🔥😍 SSH-PLUS-MANAGER 😍🔥"
echo -e "\033[1;32m======================"
echo -e "\033[1;32m=✓ LICENCIA GENERADA"
echo -e "\033[1;32m=✓ HWID REGISTRADO"
echo -e "\033[1;32m=✓ SISTEMA PROTEGIDO"
echo -e "\033[1;32m======================="
echo ""
echo -e "\033[1;32mᗚ IP del Servidor • ๛\033[1;37m $IP"
echo -e "\033[1;32mᗚ Nombre • ๛\033[1;37m $nome"
echo -e "\033[1;32mᗚ HWID • ๛\033[1;37m $hwid_cliente"
echo -e "\033[1;32mᗚ Limite •\033[1;37m $limite"
echo -e "\033[1;32mᗚ Licencia •\033[1;37m $KEY"
echo -e "\033[1;32mᗚ Validez •\033[1;37m $dias días"
echo ""
echo -e "\033[1;32m࿂ Licencia • $KEY"
echo -e "\033[1;32m [-] ═───────◇───────═"
echo -e "\033[1;32m࿂ Sistema • HWID Protegido"
echo -e "\033[1;32m [-] ═───────◇───────═"
echo -e "\033[1;32m›☬[•] SCRIPTS ═◇ SSH-PLUS-MANAGER ◇═ [•]☬"
echo ""
echo -e "\033[1;33mDespués de $dias días la licencia"
echo -e "\033[1;32m$nome \033[1;33mexpirará automáticamente.\033[0m"
echo ""
echo -e "\033[1;33mGuarda esta información para validar el HWID.\033[0m"
echo ""
read -p "ENTER para volver al menú..."
exit